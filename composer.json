{
    "name": "humanmade/jumplinks-navigation",
    "description": "Named in-page anchor points and an auto-generated navigation list of them.",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "authors": [
        {
            "name": "Human Made Limited",
            "email": "engineering@humanmade.com"
        }
    ],
    "require": {
        "composer/installers": "^1 || ^2"
    },
    "require-dev": {
        "humanmade/coding-standards": "^2.3"
    },
    "scripts": {
        "phpcs": "phpcs --standard=HM -s --extensions=php plugin.php inc src"
    },
    "config": {
        "allow-plugins": {
            "composer/installers": true,
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    }
}
